<Window x:Class="Ardesia.GeoGebraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Grafico – GeoGebra" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="15" Foreground="{StaticResource TextBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="InsertButton" Content="Inserisci nella pagina" IsEnabled="False"
                            Style="{StaticResource AccentButton}" Click="Insert_Click" Margin="0,0,8,0" />
                    <Button Content="Annulla" IsCancel="True" Style="{StaticResource PlainButton}" />
                </StackPanel>
                <TextBlock x:Name="Hint" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                           Foreground="{StaticResource SubtleTextBrush}" Text="Caricamento di GeoGebra…" />
            </DockPanel>
        </Border>
        <wv2:WebView2 x:Name="Web" />
    </DockPanel>
</Window>
