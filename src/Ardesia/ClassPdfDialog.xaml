<Window x:Class="Ardesia.ClassPdfDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF per la classe" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="28,22" Width="520">
        <TextBlock Text="PDF per la classe" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,14"
                   Text="Ardesia tiene aggiornato un PDF di questo blocco appunti, di solito accanto al file con lo stesso nome: lo rifà quando chiudi Ardesia o apri un altro blocco appunti, se ci sono modifiche. In una cartella di Google Drive condivisa con gli alunni, lo leggono da qualsiasi computer, tablet o telefono, anche Mac e iPad." />

        <CheckBox x:Name="Enabled" Content="Aggiorna da solo il PDF per la classe" FontWeight="SemiBold" />

        <StackPanel IsEnabled="{Binding IsChecked, ElementName=Enabled}" Margin="0,12,0,0">
            <TextBlock Text="File PDF" Margin="0,0,0,4" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Scegli…" Style="{StaticResource PlainButton}" Click="Browse_Click" Margin="8,0,0,0" />
                <TextBox x:Name="PathBox" IsReadOnly="True" Padding="4,5" VerticalContentAlignment="Center" />
            </DockPanel>

            <TextBlock Text="Sezioni da includere" Margin="0,16,0,4" />
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4">
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SectionList" Margin="10,6" />
                </ScrollViewer>
            </Border>
            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource SubtleTextBrush}" Margin="0,6,0,0"
                       Text="Togli il segno alle sezioni da non condividere, per esempio le verifiche." />
        </StackPanel>

        <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="#FFB3261E" Margin="0,12,0,0" Visibility="Collapsed" />

        <DockPanel Margin="0,22,0,0">
            <Button x:Name="UpdateNowButton" DockPanel.Dock="Left" Content="Aggiorna ora" Style="{StaticResource PlainButton}"
                    Click="UpdateNow_Click" IsEnabled="{Binding IsChecked, ElementName=Enabled}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" IsDefault="True" Style="{StaticResource AccentButton}" Click="Ok_Click" Margin="0,0,8,0" />
                <Button Content="Annulla" IsCancel="True" Style="{StaticResource PlainButton}" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
