<Window x:Class="Ardesia.ClassPdfDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Ardesia.Controls"
        Title="PDF per la classe" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="28,22" Width="520">
        <TextBlock Text="PDF per la classe" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
        <c:ClassPdfPanel x:Name="Panel" />

        <DockPanel Margin="0,22,0,0">
            <Button x:Name="UpdateNowButton" DockPanel.Dock="Left" Content="Aggiorna ora" Style="{StaticResource PlainButton}"
                    Click="UpdateNow_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" IsDefault="True" Style="{StaticResource AccentButton}" Click="Ok_Click" Margin="0,0,8,0" />
                <Button Content="Annulla" IsCancel="True" Style="{StaticResource PlainButton}" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
