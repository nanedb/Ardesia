<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Ardesia.Controls">

    <!-- ═════════════ Colori (palette ispirata a OneNote) ═════════════ -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF1E5A68" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#FF154550" />
    <SolidColorBrush x:Key="AccentHeaderHoverBrush" Color="#FF2B6E7D" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#FFDDEDF0" />
    <SolidColorBrush x:Key="HoverBrush" Color="#FFEEF6F8" />
    <SolidColorBrush x:Key="HoverGrayBrush" Color="#FFE9E7E5" />
    <SolidColorBrush x:Key="NavBrush" Color="#FFF3F2F1" />
    <SolidColorBrush x:Key="PagesPaneBrush" Color="#FFFAF9F8" />
    <SolidColorBrush x:Key="LineBrush" Color="#FFE1DFDD" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF323130" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF605E5C" />
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <c:BoolToVisibilityConverter x:Key="BoolToVis" />
    <c:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />

    <!-- ═════════════ Icone disegnate (riquadro 24×24) ═════════════ -->
    <Geometry x:Key="IconLasso">M12,4 C6.5,4 3,6.3 3,9.2 C3,12.1 6.5,14.4 12,14.4 C17.5,14.4 21,12.1 21,9.2 C21,6.3 17.5,4 12,4 Z M7.5,13.6 C6.2,15.4 6.8,17.4 8.4,18.2 C9.6,18.8 9.4,20.6 8.2,21.4</Geometry>
    <Geometry x:Key="IconHand">M8,13 V5.5 A1.5,1.5 0 0 1 11,5.5 V11 M11,10 V4 A1.5,1.5 0 0 1 14,4 V11 M14,10 V5 A1.5,1.5 0 0 1 17,5 V12 M17,11 V8.5 A1.5,1.5 0 0 1 20,8.5 V15 C20,19 17,22 13,22 C10,22 8.5,20.5 7,18 L4.2,13.5 A1.5,1.5 0 0 1 6.8,12 L8,14</Geometry>
    <Geometry x:Key="IconFinger">M10,21 V9.5 A1.5,1.5 0 0 1 13,9.5 V14 M13,13.5 A1.5,1.5 0 0 1 16,13.5 V15 M16,14.5 A1.5,1.5 0 0 1 19,14.5 V17.5 C19,20.5 17,22.5 14,22.5 H12.5 C10.5,22.5 9,21.5 8,19.5 L6,15.8 A1.3,1.3 0 0 1 8.2,14.6 L10,17 M5.5,4 L7.5,6 M11.5,2 V4.8 M17.5,4 L15.5,6</Geometry>
    <Geometry x:Key="IconCompass">M12,2.5 V5 M12,7 L6,21.5 M12,7 L18,21.5 M8.3,15.5 H15.7 M10.5,5.5 A1.5,1.5 0 1 0 13.5,5.5 A1.5,1.5 0 1 0 10.5,5.5 Z</Geometry>
    <Geometry x:Key="IconProtractor">M2,18 H22 M2,18 A10,10 0 0 1 22,18 M7,18 A5,5 0 0 1 17,18 M12,8 V10.5 M5,11 L6.6,12.6 M19,11 L17.4,12.6 M12,18 V16.5</Geometry>
    <Geometry x:Key="IconPointEraser">M12,4 A8,8 0 1 0 12.01,4 Z M12,10.5 A1.5,1.5 0 1 0 12.01,10.5 Z</Geometry>
    <Geometry x:Key="IconLine">M4,20 L20,4</Geometry>
    <Geometry x:Key="IconArrow">M4,20 L20,4 M11,4 H20 V13</Geometry>
    <Geometry x:Key="IconRect">M3.5,6 H20.5 V18 H3.5 Z</Geometry>
    <Geometry x:Key="IconEllipse">M2.5,12 A9.5,7 0 1 0 21.5,12 A9.5,7 0 1 0 2.5,12 Z</Geometry>
    <Geometry x:Key="IconTriangle">M12,4 L21,20 H3 Z</Geometry>
    <Geometry x:Key="IconSubpage">M4,4 H11 M8,9 H20 M8,14 H20 M8,19 H16 M4,4 V9</Geometry>
    <Geometry x:Key="IconBgBlank">M3,3 H21 V21 H3 Z</Geometry>
    <Geometry x:Key="IconBgLinesNarrow">M3,3 H21 V21 H3 Z M3,7.5 H21 M3,12 H21 M3,16.5 H21</Geometry>
    <Geometry x:Key="IconBgLinesWide">M3,3 H21 V21 H3 Z M3,9 H21 M3,15 H21</Geometry>
    <Geometry x:Key="IconBgGridSmall">M3,3 H21 V21 H3 Z M3,7.5 H21 M3,12 H21 M3,16.5 H21 M7.5,3 V21 M12,3 V21 M16.5,3 V21</Geometry>
    <Geometry x:Key="IconBgGridLarge">M3,3 H21 V21 H3 Z M3,12 H21 M12,3 V21</Geometry>
    <Geometry x:Key="IconBgDots">M3,3 H21 V21 H3 Z M7.5,7.5 h0.1 M12,7.5 h0.1 M16.5,7.5 h0.1 M7.5,12 h0.1 M12,12 h0.1 M16.5,12 h0.1 M7.5,16.5 h0.1 M12,16.5 h0.1 M16.5,16.5 h0.1</Geometry>

    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Stroke" Value="{StaticResource TextBrush}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
    </Style>

    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SmallGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- ═════════════ Pulsanti della barra multifunzione ═════════════ -->
    <ControlTemplate x:Key="RibbonLargeTemplate" TargetType="ButtonBase">
        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                CornerRadius="4" Padding="5,4,5,3" MinWidth="56">
            <StackPanel>
                <Grid Height="30">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding Path=(c:Rb.Label), RelativeSource={RelativeSource TemplatedParent}}"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="74" FontSize="12"
                           LineHeight="14" LineStackingStrategy="BlockLineHeight" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="RibbonSmallTemplate" TargetType="ButtonBase">
        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                CornerRadius="4" Padding="6,3,8,3">
            <StackPanel Orientation="Horizontal">
                <ContentPresenter VerticalAlignment="Center" Width="18" />
                <TextBlock Text="{Binding Path=(c:Rb.Label), RelativeSource={RelativeSource TemplatedParent}}"
                           FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="IconButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                CornerRadius="4" Width="34" Height="34">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="RibbonBase" TargetType="ButtonBase">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="600" />
    </Style>

    <Style x:Key="RibbonLargeButton" TargetType="Button" BasedOn="{StaticResource RibbonBase}">
        <Setter Property="Template" Value="{StaticResource RibbonLargeTemplate}" />
    </Style>
    <Style x:Key="RibbonLargeToggle" TargetType="ToggleButton" BasedOn="{StaticResource RibbonBase}">
        <Setter Property="Template" Value="{StaticResource RibbonLargeTemplate}" />
    </Style>
    <Style x:Key="RibbonSmallButton" TargetType="Button" BasedOn="{StaticResource RibbonBase}">
        <Setter Property="Template" Value="{StaticResource RibbonSmallTemplate}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource RibbonBase}">
        <Setter Property="Template" Value="{StaticResource IconButtonTemplate}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource RibbonBase}">
        <Setter Property="Template" Value="{StaticResource IconButtonTemplate}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ═════════════ Barre di scorrimento sottili ═════════════ -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="B" CornerRadius="3" Background="#FFC4C4C4" Margin="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#FF9E9E9E" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#FF7A7A7A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═════════════ Penne ═════════════ -->
    <Style x:Key="PenToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PenChevron" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="Colore e spessore" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                   Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFD5E6EA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BarSeparator" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Background" Value="{StaticResource LineBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Campioni di colore / spessore -->
    <Style x:Key="Swatch" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2.5" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="#FFC8C6C4" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SwatchDot" TargetType="Ellipse">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Stroke" Value="#40000000" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <!-- Gruppo della barra multifunzione: contenuto + etichetta in basso -->
    <Style x:Key="RibbonGroup" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="6,0" Margin="0,4">
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Bottom" ContentSource="Header" HorizontalAlignment="Center"
                                              Margin="0,2,0,0" TextElement.FontSize="11"
                                              TextElement.Foreground="{StaticResource SubtleTextBrush}" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Schede della barra multifunzione -->
    <Style x:Key="RibbonTabControl" TargetType="TabControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel Background="White">
                        <TabPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="8,0,0,0" />
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Height="102">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                                <ContentPresenter ContentSource="SelectedContent" Margin="6,0" />
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RibbonTab" TargetType="TabItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Root" Background="Transparent" Margin="0,0,2,0">
                        <ContentPresenter x:Name="Hd" ContentSource="Header" Margin="14,9,14,9"
                                          TextElement.FontSize="13" TextElement.Foreground="{StaticResource TextBrush}" />
                        <Border x:Name="Bar" Height="3" VerticalAlignment="Bottom" Margin="12,0"
                                CornerRadius="1.5" Background="{StaticResource AccentBrush}" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Hd" Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Hd" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra del titolo viola -->
    <Style x:Key="HeaderButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHeaderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDarkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeaderGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Pannelli di navigazione -->
    <Style x:Key="PaneHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="14,12,8,8" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="NavAddButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="6,4" Padding="10,8">
                        <ContentPresenter TextElement.FontSize="14" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverGrayBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ExpanderToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Path x:Name="Chevron" Data="M0,0 L4.5,4.5 L0,9" Stroke="{StaticResource SubtleTextBrush}"
                              StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavTree" TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2,0,2,8" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="AllowDrop" Value="True" />
    </Style>

    <Style x:Key="NavTreeItem" TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="4,1" Padding="0,6,8,6">
                            <DockPanel>
                                <ToggleButton x:Name="Expander" DockPanel.Dock="Left" Style="{StaticResource ExpanderToggle}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press" />
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverGrayBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}" />
                            <Setter TargetName="Bd" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InlineEditBox" TargetType="TextBox">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDarkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlainButton" TargetType="Button">
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#FF8A8886" />
    </Style>
</ResourceDictionary>
