<UserControl x:Class="Ardesia.Editor.PageEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ardesia.Editor">
    <Grid>
        <ScrollViewer x:Name="Scroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#FFE6E6E6"
                      Focusable="False"
                      PanningMode="None">
            <Grid x:Name="ContentHost" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                </Grid.LayoutTransform>

                <local:ArdesiaInkCanvas x:Name="Ink" Width="1200" Height="900" Background="White" />

                <StackPanel x:Name="TitleArea" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="48,24,0,0">
                    <Grid>
                        <TextBlock x:Name="TitlePlaceholder" Text="Titolo della pagina"
                                   FontFamily="Calibri Light, Segoe UI Light" FontSize="30"
                                   Foreground="#FFA19F9D" Margin="2,2,0,0" IsHitTestVisible="False" />
                        <TextBox x:Name="TitleBox"
                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Calibri Light, Segoe UI Light" FontSize="30"
                                 MinWidth="380" MaxWidth="900"
                                 Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#FFC8C6C4"
                                 Padding="0,2" />
                    </Grid>
                    <TextBlock x:Name="DateText" FontSize="13" Foreground="#FF767676" Margin="0,6,0,0" />
                </StackPanel>

                <Canvas x:Name="Overlay" />
            </Grid>
        </ScrollViewer>

        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28"
                Background="#B0323130" CornerRadius="4" Padding="8,3" IsHitTestVisible="False">
            <TextBlock x:Name="ZoomText" Text="100%" Foreground="White" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
