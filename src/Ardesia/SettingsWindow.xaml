<Window x:Class="Ardesia.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Ardesia.Controls"
        Title="Impostazioni – Ardesia" Width="720" Height="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White"
        FontFamily="Segoe UI" FontSize="15" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <!-- Sulla LIM caselle e pulsanti devono essere grandi abbastanza per il dito -->
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BigAccent" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Padding" Value="24,11" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="BigPlain" TargetType="Button" BasedOn="{StaticResource PlainButton}">
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        </Style>
        <Style x:Key="SettingsTab" TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid x:Name="Root" Background="Transparent" Margin="0,0,4,0" Cursor="Hand">
                            <ContentPresenter x:Name="Hd" ContentSource="Header" Margin="20,13,20,13"
                                              TextElement.FontSize="16" TextElement.Foreground="{StaticResource TextBrush}" />
                            <Border x:Name="Bar" Height="4" VerticalAlignment="Bottom" Margin="14,0"
                                    CornerRadius="2" Background="{StaticResource AccentBrush}" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Hd" Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Hd" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Pulsanti in fondo -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" IsDefault="True" Style="{StaticResource BigAccent}" Click="Ok_Click" Margin="0,0,10,0" />
                <Button Content="Annulla" IsCancel="True" Style="{StaticResource BigPlain}" />
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="Impostazioni" FontSize="24" FontWeight="SemiBold" Margin="28,20,28,6" />

        <TabControl x:Name="Tabs" BorderThickness="0" Padding="0" Margin="20,0,20,0" Background="White">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent" />
                    </DockPanel>
                </ControlTemplate>
            </TabControl.Template>

            <!-- ══════════ Questo PC ══════════ -->
            <TabItem Style="{StaticResource SettingsTab}" Header="Questo PC">
                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <StackPanel Margin="8,18,8,18">
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18"
                                   Text="Queste impostazioni valgono solo per questo computer (o questa LIM), per tutti i blocchi appunti." />

                        <TextBlock Style="{StaticResource GroupTitle}" Text="Tocco e LIM" />
                        <CheckBox x:Name="FingerPansBox" Content="Il dito sposta la pagina" FontWeight="SemiBold" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Da attivare sulle LIM che distinguono la penna dal dito (per esempio Newline): la penna scrive, il dito sposta la pagina. Lascialo spento sulle LIM dove penna e dito arrivano uguali (per esempio Promethean): lì anche il dito scrive." />
                        <DockPanel Margin="0,14,0,0">
                            <Button DockPanel.Dock="Left" Content="Prova del tocco della LIM…" Style="{StaticResource BigPlain}"
                                    Click="TouchTest_Click" Margin="0,0,14,0" />
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                       Text="Mostra come Windows riceve penna, dito e palmo: serve a capire se attivare l'opzione qui sopra." />
                        </DockPanel>

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,24,0,20" />

                        <TextBlock Style="{StaticResource GroupTitle}" Text="File recenti" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="I blocchi appunti che compaiono in File › Recenti. Togliere un file dall'elenco non lo cancella." />
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel x:Name="RecentList" />
                        </Border>
                        <TextBlock x:Name="RecentEmpty" Style="{StaticResource Hint}" Margin="12,10" Text="L'elenco è vuoto." Visibility="Collapsed" />
                        <Button x:Name="ClearRecentButton" Content="Svuota l'elenco" Style="{StaticResource BigPlain}"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Click="ClearRecent_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════ Questo blocco appunti ══════════ -->
            <TabItem x:Name="NotebookTab" Style="{StaticResource SettingsTab}" Header="Questo blocco appunti">
                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <StackPanel Margin="8,18,8,18">
                        <TextBlock x:Name="NotebookHint" Style="{StaticResource Hint}" Margin="0,0,0,18" />

                        <TextBlock Style="{StaticResource GroupTitle}" Text="PDF per la classe" />
                        <c:ClassPdfPanel x:Name="ClassPdf" />
                        <Button x:Name="UpdateNowButton" Content="Aggiorna ora il PDF" Style="{StaticResource BigPlain}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" Click="UpdateNow_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
