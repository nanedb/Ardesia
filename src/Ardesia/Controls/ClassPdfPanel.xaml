<UserControl x:Class="Ardesia.Controls.ClassPdfPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Impostazioni del PDF per la classe: usato da «PDF per la classe…» e dalle Impostazioni -->
    <StackPanel>
        <TextBlock x:Name="Intro" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,14"
                   Text="Ardesia tiene aggiornato un PDF di questo blocco appunti, di solito accanto al file con lo stesso nome: lo rifà quando chiudi Ardesia o apri un altro blocco appunti, se ci sono modifiche. In una cartella di Google Drive condivisa con gli alunni, lo leggono da qualsiasi computer, tablet o telefono, anche Mac e iPad." />

        <CheckBox x:Name="Enabled" Content="Aggiorna da solo il PDF per la classe" FontWeight="SemiBold" VerticalContentAlignment="Center" />

        <!-- Blocco su Google Drive: il PDF è su Drive accanto al blocco, con un link fisso (docs/google-drive.md §6) -->
        <Border x:Name="DriveBox" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,10" CornerRadius="4"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="DriveStatus" TextWrapping="Wrap" />
                <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="CopyLinkButton" Content="Copia il link per gli alunni" Style="{StaticResource PlainButton}"
                            Click="CopyLink_Click" Margin="0,0,8,6" />
                    <Button x:Name="OpenPdfButton" Content="Apri il PDF su Drive" Style="{StaticResource PlainButton}"
                            Click="OpenPdf_Click" Margin="0,0,8,6" />
                    <Button x:Name="RetryShareButton" Content="Riprova a condividere" Style="{StaticResource PlainButton}"
                            Click="RetryShare_Click" Margin="0,0,0,6" Visibility="Collapsed" />
                </WrapPanel>
                <TextBlock x:Name="DriveNote" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource SubtleTextBrush}" />
            </StackPanel>
        </Border>

        <StackPanel IsEnabled="{Binding IsChecked, ElementName=Enabled}" Margin="0,12,0,0">
            <StackPanel x:Name="FileRow">
                <TextBlock Text="File PDF" Margin="0,0,0,4" />
                <DockPanel Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right" Content="Scegli…" Style="{StaticResource PlainButton}" Click="Browse_Click" Margin="8,0,0,0" />
                    <TextBox x:Name="PathBox" IsReadOnly="True" Padding="4,5" VerticalContentAlignment="Center" />
                </DockPanel>
            </StackPanel>

            <TextBlock Text="Sezioni da includere" Margin="0,0,0,4" />
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4">
                <ScrollViewer x:Name="SectionScroll" MaxHeight="240" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <StackPanel x:Name="SectionList" Margin="10,6" />
                </ScrollViewer>
            </Border>
            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource SubtleTextBrush}" Margin="0,6,0,0"
                       Text="Togli il segno alle sezioni da non condividere, per esempio le verifiche." />
        </StackPanel>

        <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
