<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Ardesia</RootNamespace>
    <AssemblyName>Ardesia</AssemblyName>
    <Product>Ardesia</Product>
    <Description>Blocco appunti per lavagne interattive (LIM)</Description>
    <Version>0.7.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Ardesia.ico</ApplicationIcon>
    <NeutralLanguage>it-IT</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Ardesia.ico" />
  </ItemGroup>

  <!-- Client Google col secret: google-client.json nella cartella principale, escluso da Git e incorporato se c'è -->
  <ItemGroup Condition="Exists('..\..\google-client.json')">
    <EmbeddedResource Include="..\..\google-client.json" LogicalName="google-client.json" Link="google-client.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

</Project>
